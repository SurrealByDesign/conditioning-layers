      "mode": 0,
      "inputs": [],
      "outputs": [],
      "properties": {},
      "widgets_values": [
        "Open the Painted Field: click Edit Field… (or double-click the thumbnail). Choose Erase and wipe out both boots, so only the upper armor glows. Then choose Paint, set Influence (%) to 40 and paint over the chest: Paint moves cells toward that value, so the rune dims. Press Done."
      ],
      "title": "TRY THIS",
      "color": "#232",
      "bgcolor": "#353"
    },
